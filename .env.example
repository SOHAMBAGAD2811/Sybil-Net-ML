# Primary provider — get your FREE key at https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Legacy fallback — only needed if you still want to use Etherscan
# ETHERSCAN_API_KEY=your_etherscan_key_here

# ─── Week 7: Cross-Chain Bridge ────────────────────────────────────────────
# The same ALCHEMY_API_KEY works for all supported chains:
#   Ethereum (eth-mainnet), Polygon (polygon-mainnet),
#   Arbitrum (arb-mainnet), Base (base-mainnet)
# No additional keys needed — Alchemy routes by subdomain.

# Smart contract addresses (set after deployment)
# SYBILNET_ADDRESS=0x...
# BRIDGE_ADDRESS=0x...

# Private key for contract deployment (NEVER commit this)
# DEPLOYER_PRIVATE_KEY=0x...
